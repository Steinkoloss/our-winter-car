<Project>

  <PropertyGroup>
    <Product>WinterMP</Product>
    <Authors>Our Winter Car contributors</Authors>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Local, per-machine overrides (not committed). Copy Directory.Build.props.user.example
    to Directory.Build.props.user and set MwcGamePath to enable auto-deploy of the
    plugins into the game's BepInEx folder after every build.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

</Project>
