<Project>

  <PropertyGroup>
    <Product>WinterMP</Product>
    <Authors>Our Winter Car contributors</Authors>
    <Copyright>Copyright (C) 2025 Steinkoloss and contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <!-- Nullable reference types are on for every project (AGENTS.md hard constraint).
         Centralized here so it can't drift per-project. -->
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Local, per-machine overrides (not committed). Copy Directory.Build.props.user.example
    to Directory.Build.props.user and set MwcGamePath to enable auto-deploy of the
    plugins into the game's BepInEx folder after every build.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

</Project>
