<Window x:Class="WinterMP.Launcher.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Info"
        Width="560" Height="420"
        Background="{StaticResource BgBrush}"
        FontSize="14"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Info" FontSize="24" FontWeight="Bold" Margin="0,0,0,16" />

        <Border Grid.Row="1" Style="{StaticResource SectionBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Game" Style="{StaticResource LabelStyle}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="GameStatusText"
                           Style="{StaticResource ValueStyle}" Text="Searching…" TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="BepInEx" Style="{StaticResource LabelStyle}" Margin="0,10,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="BepInExStatusText"
                           Style="{StaticResource ValueStyle}" Text="—" Margin="0,10,0,0" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Mod" Style="{StaticResource LabelStyle}" Margin="0,10,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ModStatusText"
                           Style="{StaticResource ValueStyle}" Text="—" Margin="0,10,0,0" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Backups" Style="{StaticResource LabelStyle}" Margin="0,10,0,0" />
                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="BackupStatusText"
                           Style="{StaticResource ValueStyle}" Text="—" Margin="0,10,0,0" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Versions" Style="{StaticResource LabelStyle}" Margin="0,10,0,0" />
                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="BuildStatusText"
                           Style="{StaticResource ValueStyle}" Text="—" TextTrimming="CharacterEllipsis"
                           ToolTipService.ShowOnDisabled="True" Margin="0,10,0,0" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Updates" Style="{StaticResource LabelStyle}" Margin="0,10,0,0" />
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="UpdateStatusText"
                           Style="{StaticResource ValueStyle}" Text="Not checked yet"
                           TextWrapping="Wrap" Margin="0,10,0,0" />
                <Button Grid.Row="5" Grid.Column="2" x:Name="CheckButton" Content="Check"
                        Click="CheckButton_Click" Margin="10,10,0,0" Padding="14,6" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <Button Grid.Row="2" Content="Done" Click="Done_Click" HorizontalAlignment="Right"
                MinWidth="110" Margin="0,16,0,0" />
    </Grid>
</Window>
