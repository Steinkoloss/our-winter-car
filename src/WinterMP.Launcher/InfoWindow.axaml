<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WinterMP.Launcher.InfoWindow"
        Title="Info"
        Width="560" Height="440"
        Background="{StaticResource BgBrush}"
        FontSize="14"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Info" FontSize="24" FontWeight="Bold" Margin="0,0,0,16" />

        <Border Grid.Row="1" Classes="section">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Game" Classes="label" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="GameStatusText"
                           Classes="value" Text="Searching…" TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="BepInEx" Classes="label" Margin="0,10,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BepInExStatusText"
                           Classes="value" Text="—" Margin="0,10,0,0" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Mod" Classes="label" Margin="0,10,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ModStatusText"
                           Classes="value" Text="—" Margin="0,10,0,0" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Backups" Classes="label" Margin="0,10,0,0" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BackupStatusText"
                           Classes="value" Text="—" Margin="0,10,0,0" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Versions" Classes="label" Margin="0,10,0,0" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BuildStatusText"
                           Classes="value" Text="—" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Updates" Classes="label" Margin="0,10,0,0" />
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="UpdateStatusText"
                           Classes="value" Text="Checking…" TextWrapping="Wrap" Margin="0,10,0,0" />
            </Grid>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Tester guide" Click="TesterGuide_Click" Margin="0,0,8,0" />
            <Button Content="Export diagnostics" Click="ExportDiagnostics_Click" Margin="0,0,8,0" />
            <Button Content="Done" Click="Done_Click" MinWidth="80" />
        </WrapPanel>
    </Grid>
</Window>
