<Window x:Class="WinterMP.Launcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Our Winter Car settings"
        Width="560" Height="440"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Game folder" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                   Text="Leave empty to auto-detect via Steam. Use Browse only if detection fails." />

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="GamePathBox" Padding="8,6" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0" />
        </Grid>

        <TextBlock Grid.Row="3" Text="GitHub token (updates)" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Grid.Row="4" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                   Text="Optional. Only needed if GitHub update checks fail. Create a read-only token at github.com/settings/tokens." />
        <PasswordBox Grid.Row="5" x:Name="GitHubTokenBox" Padding="8,6" Margin="0,0,0,16" />

        <StackPanel Grid.Row="6">
            <Button Content="Remove mod from game" Click="RemoveMod_Click"
                    HorizontalAlignment="Left" Background="#FF5A2C2C" />
            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Text="Removes BepInEx/plugins/WinterMP only. BepInEx itself stays installed." />
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0" />
            <Button Content="Save" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
