<Window x:Class="WinterMP.Launcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="560" Height="580"
        Background="{StaticResource BgBrush}"
        FontSize="14"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Game folder" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,0,0,10"
                                   Text="Leave empty to auto-detect via Steam. Browse only if detection fails." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GamePathBox" />
                            <Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Margin="10,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="Graphics" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Resolution" Style="{StaticResource LabelStyle}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ResolutionCombo" Margin="0,0,10,10"
                                  SelectionChanged="DisplaySetting_Changed" />
                        <CheckBox Grid.Row="1" Grid.Column="2" x:Name="WindowedCheck" Content="Windowed"
                                  VerticalAlignment="Center" Margin="0,0,0,10"
                                  Checked="DisplaySetting_Changed" Unchecked="DisplaySetting_Changed" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Quality" Style="{StaticResource LabelStyle}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="QualityCombo" Margin="0,0,0,10"
                                  SelectionChanged="DisplaySetting_Changed" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Monitor" Style="{StaticResource LabelStyle}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="MonitorCombo"
                                  SelectionChanged="MonitorCombo_SelectionChanged" />
                    </Grid>
                </Border>

                <StackPanel Margin="4,0,0,8">
                    <Button Content="Remove mod from game" Click="RemoveMod_Click"
                            HorizontalAlignment="Left" Background="#FF5A2C2C" />
                    <TextBlock Style="{StaticResource HintStyle}" Margin="0,10,0,0"
                               Text="Removes BepInEx/plugins/WinterMP only. BepInEx stays installed." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Done" Click="Done_Click" HorizontalAlignment="Right"
                MinWidth="110" Margin="0,16,0,0" />
    </Grid>
</Window>
