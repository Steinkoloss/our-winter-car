<Window x:Class="WinterMP.Launcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="520" Height="480"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

        <Border Grid.Row="1" Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="Graphics" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Resolution" Style="{StaticResource LabelStyle}" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ResolutionCombo" Margin="0,0,8,8"
                          SelectionChanged="DisplaySetting_Changed" />
                <CheckBox Grid.Row="1" Grid.Column="2" x:Name="WindowedCheck" Content="Windowed"
                          VerticalAlignment="Center" Margin="0,0,0,8"
                          Checked="DisplaySetting_Changed" Unchecked="DisplaySetting_Changed" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Quality" Style="{StaticResource LabelStyle}" />
                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="QualityCombo" Margin="0,0,0,8"
                          SelectionChanged="DisplaySetting_Changed" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Monitor" Style="{StaticResource LabelStyle}" />
                <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="MonitorCombo"
                          SelectionChanged="MonitorCombo_SelectionChanged" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <Button Content="Remove mod from game" Click="RemoveMod_Click"
                    HorizontalAlignment="Left" Background="#FF5A2C2C" />
            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"
                       Text="Removes BepInEx/plugins/WinterMP only. BepInEx stays installed." />
        </StackPanel>

        <Button Grid.Row="3" Content="Done" Click="Done_Click" HorizontalAlignment="Right"
                MinWidth="100" Margin="0,16,0,0" />
    </Grid>
</Window>
