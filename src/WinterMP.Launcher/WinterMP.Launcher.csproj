<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Cross-platform: Avalonia replaces WPF so the one launcher runs natively on
         Linux, Windows and macOS. Built as net8.0; RollForward=Major lets it run on a
         newer installed runtime (e.g. a machine with only the .NET 10 runtime). -->
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <RootNamespace>WinterMP.Launcher</RootNamespace>
    <AssemblyName>WinterMPLauncher</AssemblyName>
    <Version>0.1.28</Version>
    <!-- Avalonia compiles XAML ahead of time; keep diagnostics readable. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <WinterMPCoreOut>$(MSBuildThisFileDirectory)..\WinterMP.Core\bin\$(Configuration)\net35</WinterMPCoreOut>
    <WinterMPFastBootOut>$(MSBuildThisFileDirectory)..\WinterMP.FastBoot\bin\$(Configuration)\net35</WinterMPFastBootOut>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.8" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.8" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.8" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.8" />
    <!-- Avalonia dev tools (F12) only in Debug builds. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.8" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="MessageBox.Avalonia" Version="3.2.0" />
    <!-- Unity stores display prefs in the Windows registry; types must resolve on the
         net8.0 (non-windows) TFM. All calls are guarded by OperatingSystem.IsWindows(). -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\BepInEx.cfg" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\PLAYERS.md" Link="PLAYERS.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="StageLauncherPayload" AfterTargets="Build;Publish">
    <PropertyGroup>
      <LauncherStageDir Condition="'$(PublishDir)' != ''">$(PublishDir)</LauncherStageDir>
      <LauncherStageDir Condition="'$(LauncherStageDir)' == ''">$(TargetDir)</LauncherStageDir>
    </PropertyGroup>
    <ItemGroup>
      <ModPayloadFiles Include="$(WinterMPCoreOut)\WinterMP.Core.dll;$(WinterMPCoreOut)\WinterMP.Net.dll;$(WinterMPCoreOut)\sync-catalog.json;$(WinterMPFastBootOut)\WinterMP.FastBoot.dll" />
      <BepInExZip Include="$(MSBuildThisFileDirectory)..\..\vendor\BepInEx_win_x64_5.4.23.5.zip" />
    </ItemGroup>
    <MakeDir Directories="$(LauncherStageDir)payload" />
    <MakeDir Directories="$(LauncherStageDir)vendor" />
    <Copy SourceFiles="@(ModPayloadFiles)" DestinationFolder="$(LauncherStageDir)payload" SkipUnchangedFiles="false"
          Condition="Exists('%(ModPayloadFiles.Identity)')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Assets\wintermp-compat.json"
          DestinationFolder="$(LauncherStageDir)payload" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(BepInExZip)" DestinationFolder="$(LauncherStageDir)vendor" SkipUnchangedFiles="true"
          Condition="Exists('@(BepInExZip)')" />
    <Warning Text="WinterMP.Core Release build not found - build src/WinterMP.Core in Release first so the mod payload can be bundled."
             Condition="!Exists('$(WinterMPCoreOut)\WinterMP.Core.dll')" />
    <Warning Text="WinterMP.FastBoot Release build not found - build src/WinterMP.FastBoot in Release first so the FastBoot payload can be bundled."
             Condition="!Exists('$(WinterMPFastBootOut)\WinterMP.FastBoot.dll')" />
    <Warning Text="vendor/BepInEx_win_x64_5.4.23.5.zip missing - the launcher cannot install BepInEx until it is restored."
             Condition="!Exists('@(BepInExZip)')" />
  </Target>

</Project>
