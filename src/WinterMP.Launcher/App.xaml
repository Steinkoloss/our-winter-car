<Application x:Class="WinterMP.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#FF161A20" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FF1F2530" />
        <SolidColorBrush x:Key="FgBrush" Color="#FFE8EAED" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9AA3AF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4FA3FF" />
        <SolidColorBrush x:Key="OkBrush" Color="#FF5CCB7E" />
        <SolidColorBrush x:Key="WarnBrush" Color="#FFE5A84B" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="BorderBrush" Value="#FF3A4250" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2A3240" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
