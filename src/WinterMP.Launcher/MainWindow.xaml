<Window x:Class="WinterMP.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="Our Winter Car Launcher"
        Width="720" Height="620"
        MinWidth="640" MinHeight="520"
        Background="{StaticResource BgBrush}"
        FontSize="14"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Our Winter Car" FontSize="32" FontWeight="Bold" />
                <TextBlock x:Name="SubtitleText" Text="Co-op multiplayer only · host or join via Steam"
                           FontSize="15" Foreground="{StaticResource SubtleBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Info" Click="InfoButton_Click" Padding="18,9" Margin="0,0,10,0" />
                <Button Content="Settings" Click="SettingsButton_Click" Padding="18,9" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" x:Name="UpdateBannerPanel" Background="#FF2A2418" CornerRadius="8"
                Padding="14" Margin="0,0,0,12" Visibility="Collapsed"
                BorderBrush="#FFE8C547" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="UpdateBannerTitle" Text="Update available" FontWeight="SemiBold" FontSize="15"
                           Foreground="#FFE8C547" Margin="0,0,0,6" />
                <TextBlock x:Name="UpdateBannerText" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12" />
                <WrapPanel>
                    <Button x:Name="UpdateLauncherButton" Content="Update launcher" Click="UpdateLauncherButton_Click"
                            Margin="0,0,8,0" Background="#FF3A4A5E" />
                    <Button x:Name="UpdateModButton" Content="Update mod" Click="UpdateModButton_Click"
                            Margin="0,0,8,0" IsEnabled="False" />
                    <Button x:Name="UpdateReleaseNotesButton" Content="Release notes" Click="UpdateReleaseNotesButton_Click"
                            Margin="0,0,8,0" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="WarningStatusText" Foreground="{StaticResource WarnBrush}"
                   FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Backup save" Click="BackupButton_Click" Margin="0,0,10,0" />
            <Button Content="Restore save…" Click="RestoreButton_Click" Margin="0,0,10,0" />
            <Button x:Name="OpenGameButton" Content="Open game folder" Click="OpenGameButton_Click" IsEnabled="False" />
        </StackPanel>

        <Border Grid.Row="4" Style="{StaticResource SectionBorderStyle}" MinHeight="100">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Activity" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="13"
                               Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="5" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="HostButton" Click="HostButton_Click"
                    Background="#FF2C5E33" FontSize="18" FontWeight="SemiBold" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="HOST GAME" HorizontalAlignment="Center" Foreground="{StaticResource FgBrush}" />
                    <TextBlock Text="backs up save · waits for a friend to join"
                               FontSize="13" FontWeight="Normal"
                               Foreground="#FFD4E8DA" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" x:Name="JoinButton" Click="JoinButton_Click"
                    FontSize="18" FontWeight="SemiBold" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="JOIN GAME" HorizontalAlignment="Center" />
                    <TextBlock Text="join a friend via Steam · not single player"
                               FontSize="13" FontWeight="Normal"
                               Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
