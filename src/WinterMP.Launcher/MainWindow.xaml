<Window x:Class="WinterMP.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="Our Winter Car Launcher"
        Width="640" Height="640"
        MinWidth="560" MinHeight="580"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Our Winter Car" FontSize="30" FontWeight="Bold" />
                <TextBlock x:Name="SubtitleText" Text="Install the mod · host co-op sessions · open the game"
                           FontSize="14" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Button Content="Settings" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="SettingsButton_Click" />
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Game" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="GameStatusText" Text="Searching..." TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="BepInEx" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BepInExStatusText" Text="—" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Mod" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ModStatusText" Text="—" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Save backups" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BackupStatusText" Text="—" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Build" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BuildStatusText" Text="—" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Updates" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="UpdateStatusText" Text="Not checked yet" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border Grid.Row="2" x:Name="UpdateBannerPanel" Background="#FF2A2418" CornerRadius="8"
                Padding="12" Margin="0,0,0,10" Visibility="Collapsed"
                BorderBrush="#FFE8C547" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="UpdateBannerTitle" Text="Update available" FontWeight="SemiBold"
                           Foreground="#FFE8C547" Margin="0,0,0,4" />
                <TextBlock x:Name="UpdateBannerText" TextWrapping="Wrap" Margin="0,0,0,10" />
                <WrapPanel>
                    <Button x:Name="UpdateLauncherButton" Content="Update launcher" Click="UpdateLauncherButton_Click"
                            Margin="0,0,8,0" Background="#FF3A4A5E" />
                    <Button x:Name="UpdateModButton" Content="Update mod" Click="UpdateModButton_Click"
                            Margin="0,0,8,0" IsEnabled="False" />
                    <Button x:Name="UpdateReleaseNotesButton" Content="Release notes" Click="UpdateReleaseNotesButton_Click"
                            Margin="0,0,8,0" />
                    <Button x:Name="DismissUpdateButton" Content="Dismiss" Click="DismissUpdateButton_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" x:Name="WarningStatusText" Foreground="{StaticResource WarnBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />

        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="InstallButton" Content="Install / Repair" Click="InstallButton_Click" Margin="0,0,8,8" />
                <Button Content="Check for updates" Click="CheckUpdatesButton_Click" Margin="0,0,8,8" />
                <Button Content="Refresh" Click="RefreshButton_Click" Margin="0,0,8,8" />
                <Button Content="Backup save" Click="BackupButton_Click" Margin="0,0,8,8" />
                <Button Content="Restore save…" Click="RestoreButton_Click" Margin="0,0,8,8" />
                <Button Content="Diagnostics zip" Click="DiagnosticsButton_Click" Margin="0,0,8,8" />
                <Button x:Name="OpenGameButton" Content="Open game folder" Click="OpenGameButton_Click" Margin="0,0,8,8" />
                <Button Content="Help" Click="HelpButton_Click" Margin="0,0,8,8" />
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="5" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="6" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="HostButton" Click="HostButton_Click"
                    Background="#FF2C5E33" FontSize="16" FontWeight="SemiBold" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="HOST GAME" HorizontalAlignment="Center" />
                    <TextBlock Text="backs up save · friends-only Steam lobby"
                               FontSize="11" FontWeight="Normal"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" x:Name="PlayButton" Click="PlayButton_Click"
                    FontSize="16" FontWeight="SemiBold" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="LAUNCH GAME" HorizontalAlignment="Center" />
                    <TextBlock Text="no lobby · play alone or join via Steam"
                               FontSize="11" FontWeight="Normal"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
