<Window x:Class="WinterMP.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinterMP Launcher"
        Width="600" Height="560"
        MinWidth="540" MinHeight="500"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="WinterMP" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="Multiplayer for My Winter Car"
                       FontSize="14" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <!-- Status panel -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Game" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="GameStatusText" Text="Searching..." TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="BepInEx" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BepInExStatusText" Text="—" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="WinterMP mod" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ModStatusText" Text="—" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Save backups" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BackupStatusText" Text="—" />
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" Margin="0,0,10,0" />
            <Button x:Name="InstallButton" Content="Install / Repair" Click="InstallButton_Click" Margin="0,0,10,0" />
            <Button x:Name="BackupButton" Content="Backup save now" Click="BackupButton_Click" />
        </StackPanel>

        <!-- Log -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="10">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <!-- Play -->
        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="HostButton" Click="HostButton_Click"
                    Background="#FF2C5E33" FontSize="16" FontWeight="SemiBold" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="HOST GAME" HorizontalAlignment="Center" />
                    <TextBlock Text="backs up save, opens friends-only lobby"
                               FontSize="11" FontWeight="Normal"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" x:Name="PlayButton" Click="PlayButton_Click"
                    FontSize="16" FontWeight="SemiBold" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="PLAY" HorizontalAlignment="Center" />
                    <TextBlock Text="join via Steam friends list invite"
                               FontSize="11" FontWeight="Normal"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
