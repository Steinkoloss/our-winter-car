<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>WinterMP.FastBoot</AssemblyName>
    <RootNamespace>WinterMP.FastBoot</RootNamespace>
    <Description>Boot accelerators for My Winter Car: skip splash, setup UI, auto-load save.</Description>
    <BepInExPluginGuid>com.ourwintercar.wintermp.fastboot</BepInExPluginGuid>
    <BepInExPluginName>WinterMP FastBoot</BepInExPluginName>
    <Version>0.1.27</Version>
    <MwcManaged>$(MwcGamePath)/mywintercar_Data/Managed</MwcManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="HarmonyX" Version="2.10.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(MwcManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlayMaker">
      <HintPath>$(MwcManaged)/PlayMaker.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="EnsureGameAssemblies" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MwcManaged)/UnityEngine.dll')"
           Text="MwcGamePath is not set or invalid ('$(MwcGamePath)'). Copy Directory.Build.props.user.example to Directory.Build.props.user and point it at your My Winter Car install." />
    <Error Condition="!Exists('$(MwcManaged)/PlayMaker.dll')"
           Text="PlayMaker.dll not found under MwcGamePath Managed folder." />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build"
          Condition="'$(DeployToGame)' != 'false' AND '$(MwcGamePath)' != '' AND Exists('$(MwcGamePath)/BepInEx')">
    <Copy SourceFiles="$(TargetDir)WinterMP.FastBoot.dll"
          DestinationFolder="$(MwcGamePath)/BepInEx/plugins/WinterMP" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="WinterMP.FastBoot deployed to $(MwcGamePath)/BepInEx/plugins/WinterMP" />
  </Target>

</Project>
